flowchart TD
    A["Ikazin Platform"]

    A --> M["Marketing / Público"]
    A --> AU["Auth"]
    A --> S["Área do Aluno (Ikazin)"]
    A --> D["Admin da Org (LH)"]
    A --> SA["Superadmin"]
    A --> API["APIs Ikazin"]

    M --> M1["/"]
    M --> M2["/planos"]
    M --> M3["/planos/[slug]"]
    M --> M4["/blog"]
    M --> M5["/blog/[slug]"]
    M --> M6["/builds  ← catálogo público LH (conflito)"]

    AU --> AU1["/auth/login"]
    AU --> AU2["/auth/signup"]
    AU --> AU3["/auth/forgot"]
    AU --> AU4["/auth/reset"]

    S --> S1["/orgs/[orgslug]/dashboard"]
    S --> S2["/orgs/[orgslug]/catalogo"]
    S --> S3["/orgs/[orgslug]/build/[id]"]
    S --> S4["/orgs/[orgslug]/welcome"]
    S --> S5["/orgs/[orgslug]/admin  ← superadmin only"]
    S --> S6["/orgs/[orgslug]/account"]

    D --> D1["/orgs/[orgslug]/dash"]
    D --> D2["/orgs/[orgslug]/dash/courses"]
    D --> D3["/orgs/[orgslug]/dash/users/settings/*"]
    D --> D4["/orgs/[orgslug]/dash/org/settings/*"]
    D --> D5["/orgs/[orgslug]/dash/payments/*"]
    D --> D6["/orgs/[orgslug]/dash/analytics"]

    SA --> SA1["/admin/login"]
    SA --> SA2["/admin"]
    SA --> SA3["/admin/users"]
    SA --> SA4["/admin/organizations"]

    API --> API1["GET  /api/v1/ikazin/builds"]
    API --> API2["GET  /api/v1/ikazin/builds/{id}"]
    API --> API3["GET  /api/v1/ikazin/builds/{id}/hls/*"]
    API --> API4["GET  /api/v1/ikazin/dashboard"]
    API --> API5["POST /api/v1/ikazin/progress"]
    API --> API6["PUT  /api/v1/ikazin/progress/{id}/complete"]
    API --> API7["GET  /api/v1/ikazin/downloads/{id}?file_type=X"]
    API --> API8["POST /api/v1/ikazin/downloads/{id}"]
    API --> API9["POST /api/v1/ikazin/lead-magnet"]
    API --> API10["GET  /api/v1/ikazin/recommend"]
    API --> API11["POST /api/v1/ikazin/recommend"]
    API --> API12["POST /api/v1/ikazin/admin/activate  ← superadmin"]
    API --> API13["GET  /api/v1/ikazin/admin/plan      ← superadmin"]

    T["Regras de acesso"] --> T1["Anonymous = 0 builds"]
    T --> T2["basic = Builds 1–8"]
    T --> T3["essentials = Builds 1–13"]
    T --> T4["advanced = Builds 1–18"]
    T --> T5["premium = Builds 1–25"]
    T --> T6["superadmin = premium"]
