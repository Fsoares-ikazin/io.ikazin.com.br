LEARNHOUSE_AUTH_JWT_SECRET_KEY=replace-with-at-least-32-characters
LEARNHOUSE_SQL_CONNECTION_STRING=postgresql://learnhouse:learnhouse@localhost:5432/learnhouse
LEARNHOUSE_REDIS_CONNECTION_STRING=redis://localhost:6379/learnhouse

# Frontend/API domains
LEARNHOUSE_DOMAIN=localhost:3000
LEARNHOUSE_FRONTEND_DOMAIN=localhost:3000
LEARNHOUSE_COOKIE_DOMAIN=.localhost

# HLS and real downloads via MinIO/S3-compatible storage
LEARNHOUSE_CONTENT_DELIVERY_TYPE=s3api
LEARNHOUSE_S3_API_BUCKET_NAME=ikazin-media
LEARNHOUSE_S3_API_ENDPOINT_URL=http://localhost:9000
LEARNHOUSE_S3_API_ACCESS_KEY_ID=minioadmin
LEARNHOUSE_S3_API_SECRET_ACCESS_KEY=minioadmin
LEARNHOUSE_S3_API_REGION_NAME=us-east-1

# Optional AWS-compatible aliases accepted by boto3 as fallback
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_DEFAULT_REGION=us-east-1

# Lead magnet email / SMTP
LEARNHOUSE_EMAIL_PROVIDER=smtp
LEARNHOUSE_SMTP_HOST=smtp.zoho.com
LEARNHOUSE_SMTP_PORT=587
LEARNHOUSE_SMTP_USERNAME=
LEARNHOUSE_SMTP_PASSWORD=
LEARNHOUSE_SMTP_USE_TLS=true
LEARNHOUSE_SYSTEM_EMAIL_ADDRESS=suporte@ikazin.com.br

# Ikazin checkout / Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_BASIC=price_basic
STRIPE_PRICE_ESSENTIALS=price_essentials
STRIPE_PRICE_ADVANCED=price_advanced
STRIPE_PRICE_PREMIUM=price_premium
IKAZIN_DEFAULT_ORG_SLUG=default
